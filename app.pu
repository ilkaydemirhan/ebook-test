import streamlit as st
from pypdf import PdfReader
from sentence_transformers import SentenceTransformer
import chromadb

# 1. Modelleri ve Veritabanını Yükle (Cache kullanarak)
@st.cache_resource
def load_resources():
    # Türkçe, Arapça ve İngilizce destekleyen embedding modeli
    model = SentenceTransformer('sentence-transformers/paraphrase-multilingual-mpnet-base-v2')
    
    # ChromaDB yerel istemcisi
    client = chromadb.PersistentClient(path="./ebook_db")
    collection = client.get_or_create_collection(name="ebooks")
    return model, collection

model, collection = load_resources()

# 2. Kitap İndeksleme Fonksiyonu
def index_pdf(file):
    reader = PdfReader(file)
    metadata = reader.metadata or {}
    
    # Metadata çıkarma (Varsayılan değerlerle)
    title = metadata.get('/Title', file.name)
    author = metadata.get('/Author', 'Bilinmeyen Yazar')
    page_count = len(reader.pages)
    
    # İlk birkaç sayfadan veya tüm kitaptan özet metin çıkarma
    full_text = ""
    for page in reader.pages[:10]: # İlk 10 sayfa içerik vektörü için yeterlidir
        full_text += page.extract_text() or ""
        
    # Embed Alma ve Kaydetme
    embedding = model.encode(full_text).tolist()
    
    collection.add(
        documents=[full_text[:500]], # Önizleme metni
        embeddings=[embedding],
        metadatas=[{
            "title": str(title),
            "author": str(author),
            "page_count": int(page_count)
        }],
        ids=[file.name]
    )
    return title

# 3. Streamlit Arayüzü
st.title("📚 Yapay Zeka Destekli E-Kitap Arama Motoru")
st.caption("Türkçe, Arapça ve İngilizce anlamsal arama yapabilirsiniz.")

# PDF Yükleme Bölümü (Yan Menü)
with st.sidebar:
    st.header("Kitap Ekle")
    uploaded_files = st.file_uploader("PDF Formatında Kitap Yükleyin", type=["pdf"], accept_multiple_files=True)
    if st.button("İndeksle") and uploaded_files:
        for file in uploaded_files:
            title = index_pdf(file)
            st.success(f"Eklendi: {title}")

# Arama Bölümü
query = st.text_input("Aramak istediğiniz konu, kavram veya özeti yazın (Her dilde arayabilirsiniz):")

if query:
    query_vector = model.encode(query).tolist()
    results = collection.query(
        query_embeddings=[query_vector],
        n_results=5
    )
    
    st.subheader("Arama Sonuçları")
    
    if results and results['metadatas']:
        for meta in results['metadatas'][0]:
            with st.container():
                st.markdown(f"### 📖 {meta.get('title')}")
                col1, col2 = st.columns(2)
                with col1:
                    st.write(f"**Yazar:** {meta.get('author')}")
                with col2:
                    st.write(f"**Sayfa Sayısı:** {meta.get('page_count')}")
                st.divider()
    else:
        st.info("Eşleşen sonuç bulunamadı")